# Supabase Cloud Sync Configuration
# Copy this file to .env and fill in your Supabase project credentials.

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key-here

# Store identifier (for multi-store setups)
STORE_ID=store_104

# Sync interval in seconds (default: 7200 = 2 hours)
SYNC_INTERVAL_SECONDS=7200

# Local data retention in seconds (default: 86400 = 24 hours)
LOCAL_RETENTION_SECONDS=86400
